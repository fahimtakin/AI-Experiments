{
 "manifest_version":3,

 "name":"Alfred Take Notes",

 "version":"1.0",

 "description":
 "Summarize videos and create structured notes",

 "permissions":[
   "activeTab",
   "storage",
   "scripting"
 ],

 "host_permissions":[
   "https://www.youtube.com/*"
 ],

 "action":{
   "default_popup":"index.html"
 },

 "content_scripts":[
 {
   "matches":[
    "https://www.youtube.com/*"
   ],
   "js":[
    "content.js"
   ]
 }
 ]
}